{
  "format": "custom-studio-theme",
  "version": 1,
  "id": "modern-cutie",
  "name": "모던 큐티",
  "author": "Custom Studio",
  "colors": {
    "canvas": "#fff5f9",
    "surface": "#ffffff",
    "user": "#f5edff",
    "text": "#51394f",
    "muted": "#80677d",
    "accent": "#aa467b",
    "accentSoft": "#f9e1ed",
    "border": "#ebd3e2",
    "quote": "#906594",
    "code": "#f1e9f4",
